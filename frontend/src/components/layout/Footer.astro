---
import { NAV_LINKS } from '@/lib/constants';
import { Image } from 'astro:assets';
import { treksApi, type SiteConfig, type SocialLinks } from '@/lib/api';
import { loadCities, safe } from '@/lib/marketing/server';
import type { Trek } from '@/lib/types';

interface Props {
  siteConfig: SiteConfig;
  socialLinks: SocialLinks;
}

const { siteConfig, socialLinks } = Astro.props;

const [featuredTreks, cities] = await Promise.all([
  safe<Trek[]>(treksApi.getFeatured(5), []),
  loadCities(),
]);
const popularTreks = featuredTreks.length
  ? featuredTreks.map((t) => ({ name: t.name.replace(/\s+trek$/i, ''), href: `/treks/${t.slug}` }))
  : [
      { name: 'Hampta Pass', href: '/treks/hampta-pass' },
      { name: 'Sar Pass', href: '/treks/sar-pass' },
      { name: 'Kedarkantha', href: '/treks/kedarkantha' },
      { name: 'Valley of Flowers', href: '/treks/valley-of-flowers' },
      { name: 'Roopkund', href: '/treks/roopkund' },
    ];
const planLinks = [
  { name: 'Winter trek quiz', href: '/tools/winter-trek-quiz/' },
  { name: 'Trek budget calculator', href: '/tools/trek-budget-calculator/' },
  { name: 'Student discount', href: '/student-discount/' },
  ...cities.slice(0, 4).map((c) => ({ name: `Treks from ${c.name}`, href: `/treks-from/${c.slug}/` })),
];
---

<footer class="bg-secondary-600 text-white">
  <!-- Main Footer -->
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <!-- Brand logo image (optimized Image component) -->
          <Image
            src="/logo.webp"
            alt={siteConfig.name}
            class="h-12 w-auto object-contain drop-shadow-sm"
            width={300}
            height={80}
            loading="lazy"
          />
        </a>
        <p class="text-white/70 mb-6">
          {siteConfig.description}
        </p>
        <!-- Social Links -->
        <div class="flex gap-4">
          <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/20 hover:bg-primary-500 rounded-lg flex items-center justify-center transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/20 hover:bg-primary-500 rounded-lg flex items-center justify-center transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/20 hover:bg-primary-500 rounded-lg flex items-center justify-center transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
          <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/20 hover:bg-primary-500 rounded-lg flex items-center justify-center transition-colors" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Quick Links</h4>
        <ul class="space-y-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-primary-300 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Treks -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Popular Treks</h4>
        <ul class="space-y-3">
          {popularTreks.map((link) => (
            <li><a href={link.href} class="text-white/70 hover:text-primary-300 transition-colors">{link.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Plan Your Trek -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Plan Your Trek</h4>
        <ul class="space-y-3">
          {planLinks.map((link) => (
            <li><a href={link.href} class="text-white/70 hover:text-primary-300 transition-colors">{link.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Contact Us</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-400 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-white/70">{siteConfig.address}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${siteConfig.phone}`} class="text-white/70 hover:text-primary-300 transition-colors">{siteConfig.phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="text-white/70 hover:text-primary-300 transition-colors">{siteConfig.email}</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="container-custom py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/50 text-sm">
          © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
        </p>
        <div class="flex flex-wrap justify-center md:justify-end gap-4 md:gap-6 text-sm">
          <a href="/privacy-policy" class="text-white/50 hover:text-primary-300 transition-colors">
            Privacy Policy
          </a>
          <a href="/terms-of-service" class="text-white/50 hover:text-primary-300 transition-colors">
            Terms of Service
          </a>
          <a href="/cancellation-refund" class="text-white/50 hover:text-primary-300 transition-colors">
            Cancellation &amp; Refund
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
