---
import type { Trek } from '@/lib/types';

interface Props {
  trek: Trek;
  featuredImage: string;
  durationDisplay: string;
  maxAltitude: number;
  distance: number;
  difficultyLabel: string;
  locationLabel: string;
  bestSeason: string[];
  startingPrice: string;
  bookHref: string;
  bookHrefMobile: string;
  whatsappHref: string;
  isWinterTrek: boolean;
  routeFrom?: string;
  routeTo?: string;
}

const {
  trek,
  featuredImage,
  durationDisplay,
  maxAltitude,
  distance,
  difficultyLabel,
  locationLabel,
  bestSeason,
  startingPrice,
  bookHref,
  bookHrefMobile,
  whatsappHref,
  isWinterTrek,
  routeFrom,
  routeTo,
} = Astro.props;

const titleWords = trek.name.trim().split(/\s+/);
const titleAccent = titleWords.length > 1 ? titleWords.pop() || '' : '';
const titleBase = titleWords.join(' ') || trek.name;
const description = trek.short_description || 'A remarkable Himalayan adventure awaits.';
const showRoute = Boolean(routeFrom && routeTo);
const altitudeLabel = maxAltitude > 0 ? `${maxAltitude.toLocaleString('en-IN')}m` : 'On request';
const distanceLabel = distance > 0 ? `${distance}km` : 'On request';
const seasonLabel = bestSeason.length > 0 ? bestSeason.join(' – ') : '';
---

<section class="trek-hero relative isolate overflow-hidden bg-secondary-900 text-white">
  <img
    src={featuredImage}
    alt={`${trek.name} landscape`}
    class="absolute inset-0 h-full w-full object-cover object-center"
    width="1920"
    height="600"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-[#041018]/90 via-[#07121b]/45 to-transparent"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-[#03080d]/75 via-transparent to-black/15"></div>

  {isWinterTrek && (
    <div class="trek-snow-overlay absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      {Array.from({ length: 40 }).map((_, i) => (
        <span
          class="trek-snowflake"
          style={`--delay: ${(i * 0.25) % 6}s; --x: ${(i * 13) % 100}%; --duration: ${8 + (i % 4)}s`}
        ></span>
      ))}
    </div>
  )}

  {showRoute && (
    <div class="pointer-events-none absolute inset-0 z-[2] hidden md:block" aria-hidden="true">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path
          class="trek-route-line"
          d="M 46 62 C 58 48, 70 40, 78 26"
          fill="none"
          stroke="white"
          stroke-width="0.35"
          stroke-dasharray="1.15 1.35"
          stroke-linecap="round"
        />
      </svg>
      <div class="trek-route-pin trek-route-pin--from">
        <span class="trek-route-marker"></span>
        <span class="trek-route-copy">
          <span class="trek-route-kicker">From</span>
          <span class="trek-route-place">{routeFrom}</span>
        </span>
      </div>
      <div class="trek-route-pin trek-route-pin--to">
        <span class="trek-route-marker"></span>
        <span class="trek-route-copy">
          <span class="trek-route-kicker">To</span>
          <span class="trek-route-place">{routeTo}</span>
        </span>
      </div>
    </div>
  )}

  <div class="relative z-10 mx-auto flex min-h-[40rem] w-full max-w-7xl flex-col px-4 py-5 sm:min-h-[34rem] sm:px-6 sm:py-6 md:min-h-[36rem] lg:min-h-[37.5rem] lg:px-8 lg:py-7 xl:min-h-[600px]">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-semibold sm:text-sm">
      <a href="/" class="text-primary-300 hover:text-primary-200">Home</a>
      <span class="text-white/70" aria-hidden="true">/</span>
      <a href="/treks" class="text-primary-300 hover:text-primary-200">Treks</a>
      <span class="text-white/70" aria-hidden="true">/</span>
      <span class="max-w-[14rem] truncate text-white/95 sm:max-w-md">{trek.name}</span>
    </nav>

    <div class="mt-auto flex flex-col gap-5 pt-8 md:flex-row md:items-end md:justify-between md:gap-8 lg:gap-10">
      <div class="min-w-0 max-w-3xl flex-1 md:pr-4 lg:max-w-[46rem] xl:max-w-3xl">
        <svg class="mb-0 h-8 w-36 text-primary-400 sm:h-10 sm:w-44 lg:h-11 lg:w-52" viewBox="0 0 208 48" fill="none" aria-hidden="true">
          <path d="M8 42 42 16l16 14L92 4l26 28 22-18 22 24 22-20 16 24" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="m82 16 10-12 8 10M158 18l8-10 8 10" fill="currentColor" />
        </svg>

        <h1 class="font-display text-[clamp(2.55rem,8.4vw,6.4rem)] font-normal leading-[0.82] tracking-[-0.04em] text-white drop-shadow-[0_6px_18px_rgba(0,0,0,.45)]">
          {titleBase}{titleAccent && <span class="text-primary-400"> {titleAccent}</span>}
        </h1>
        <div class="mt-2 h-[3px] w-28 rounded-full bg-gradient-to-r from-primary-400 via-primary-500 to-transparent sm:mt-3 sm:w-40"></div>

        <p class="mt-3 max-w-xl text-[13px] font-medium leading-snug text-white/95 sm:mt-4 sm:text-base md:text-lg">
          {description}
        </p>

        <div class="mt-4 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-2.5">
          <div class="hero-stat-pill">
            <svg class="hero-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke-width="1.8" /><path d="M8 3v4m8-4v4M7 11h10m-7 4h4" stroke-width="1.8" stroke-linecap="round" /></svg>
            <span>{durationDisplay}</span>
          </div>
          <div class="hero-stat-pill">
            <svg class="hero-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 19 6-10 3 5 3-4 6 9H3Z" stroke-width="1.8" stroke-linejoin="round" /><path d="m7 19 3-5 2 3 3-4 4 6" stroke-width="1.8" stroke-linejoin="round" /></svg>
            <span>{altitudeLabel}</span>
          </div>
          <div class="hero-stat-pill">
            <svg class="hero-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12Z" stroke-width="1.8" /><circle cx="12" cy="9" r="2.2" stroke-width="1.8" /></svg>
            <span>{distanceLabel}</span>
          </div>
          <div class="hero-stat-pill">
            <svg class="hero-stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10m5 10V4m5 16v-7m5 7V7" stroke-width="2" stroke-linecap="round" /></svg>
            <span>{difficultyLabel}</span>
          </div>
        </div>

        <div class="mt-3 flex flex-col gap-1.5 text-[12px] font-medium text-white/95 sm:mt-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-4 sm:text-sm">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 flex-none text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12Z" /><circle cx="12" cy="9" r="2" stroke-width="2.2" /></svg>
            {locationLabel}
          </span>
          {seasonLabel && (
            <span class="inline-flex items-center gap-1.5 sm:border-l sm:border-white/35 sm:pl-4">
              <svg class="h-4 w-4 flex-none text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke-width="1.8" /><path d="M8 3v4m8-4v4M7 11h10m-7 4h4" stroke-width="1.8" stroke-linecap="round" /></svg>
              Best season: {seasonLabel}
            </span>
          )}
        </div>

        <div class="mt-4 hidden flex-wrap gap-3 sm:mt-5 md:flex">
          <a href={bookHref} class="hero-primary-cta inline-flex !text-[#141414] hover:!text-[#141414]">
            <span>Book Now</span>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.3" d="M5 12h14m-5-5 5 5-5 5" /></svg>
          </a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="hero-whatsapp-cta inline-flex !text-white hover:!text-white">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>

      <aside class="hero-price-card w-full shrink-0 self-end md:mb-1 md:w-[15.5rem] lg:w-[17rem]" aria-label={`Starting price ${startingPrice}`}>
        <span class="hero-price-label">Starting from</span>
        <p class="mt-4 text-[2.15rem] font-extrabold leading-none tracking-tight text-white sm:text-4xl lg:text-[2.65rem]">{startingPrice}</p>
        <a href={bookHrefMobile} class="hero-primary-cta hero-price-book hero-price-book--mobile !text-[#141414] hover:!text-[#141414]">
          Book Now
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.3" d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
        <a href={bookHref} class="hero-primary-cta hero-price-book hero-price-book--desktop !text-[#141414] hover:!text-[#141414]">
          Book Now
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.3" d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .trek-hero {
    overflow: hidden;
  }

  .hero-stat-pill {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 0.7rem;
    background: rgba(8, 18, 26, 0.52);
    padding: 0.5rem 0.65rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.1;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
  }

  .hero-stat-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: #f5b041;
  }

  .hero-primary-cta,
  .hero-whatsapp-cta {
    min-height: 2.85rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.75rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .hero-primary-cta {
    background: linear-gradient(135deg, #f6a700, #ef7a12);
    color: #141414;
    box-shadow: 0 10px 22px rgba(237, 134, 19, 0.34);
  }

  .hero-whatsapp-cta {
    background: linear-gradient(135deg, #25d366, #13a34a);
    color: #fff;
    box-shadow: 0 10px 22px rgba(8, 118, 56, 0.28);
  }

  .hero-primary-cta:hover {
    color: #141414;
    transform: translateY(-1px);
  }

  .hero-whatsapp-cta:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .hero-price-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 1.15rem;
    background: linear-gradient(160deg, rgba(7, 16, 24, 0.86), rgba(10, 24, 34, 0.72));
    padding: 1.15rem 1.1rem 1.05rem;
    color: #fff;
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
  }

  .hero-price-label {
    display: inline-block;
    border-radius: 0.4rem;
    background: #f9b500;
    padding: 0.28rem 0.7rem;
    color: #141414;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    transform: rotate(-3deg);
  }

  .hero-price-book {
    margin-top: 1.25rem;
    width: 100%;
    justify-content: center;
  }

  .hero-price-book--mobile {
    display: inline-flex;
  }

  .hero-price-book--desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-price-book--mobile {
      display: none;
    }
    .hero-price-book--desktop {
      display: inline-flex;
    }
  }

  .trek-route-pin {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    color: #fff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
  }

  .trek-route-pin--from {
    left: 48%;
    top: 52%;
  }

  .trek-route-pin--to {
    left: 72%;
    top: 18%;
  }

  .trek-route-marker {
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.2rem;
    flex: none;
    border: 2px solid #fff;
    border-radius: 999px;
    background: #f39c12;
    box-shadow: 0 0 0 4px rgba(243, 156, 18, 0.28);
  }

  .trek-route-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .trek-route-kicker {
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
  }

  .trek-route-place {
    font-size: 0.92rem;
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .hero-stat-pill {
      padding: 0.58rem 0.8rem;
      font-size: 0.86rem;
    }
  }

  @media (min-width: 1280px) {
    .trek-route-pin--from {
      left: 50%;
      top: 48%;
    }
    .trek-route-pin--to {
      left: 74%;
      top: 14%;
    }
  }
</style>
