---
import type { Trek } from '@/lib/types';
import { DIFFICULTY_LABELS } from '@/lib/constants';

export interface Props {
  trek: Trek;
  class?: string;
}

const { trek, class: className = '' } = Astro.props;

const difficultyKey = (trek.difficulty || 'moderate').toLowerCase();
const difficultyInfo = DIFFICULTY_LABELS[difficultyKey] || DIFFICULTY_LABELS.moderate;

const badgeStyles: Record<string, string> = {
  easy: 'bg-emerald-500 text-white',
  moderate: 'bg-primary-500 text-white',
  difficult: 'bg-rose-500 text-white',
  challenging: 'bg-rose-600 text-white',
  extreme: 'bg-purple-600 text-white',
};

const badgeClass = badgeStyles[difficultyKey] || badgeStyles.moderate;
const featuredImage = trek.featured_image || '/images/treks/placeholder.jpg';
const durationDays = typeof trek.duration === 'number' && trek.duration > 0 ? trek.duration : 1;
const distance = trek.distance ?? 0;
const locationDisplay = trek.location
  ? (trek.location.includes(',') ? trek.location.split(',').pop()!.trim() : trek.location.trim())
  : 'Himalayas';

const formatPrice = (price: number) =>
  new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0,
  }).format(typeof price === 'number' && !isNaN(price) ? price : 0);
---

<article
  class:list={[
    'group relative bg-white rounded-2xl border border-neutral-200/80 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full',
    className,
  ]}
>
  <a
    href={`/treks/${trek.slug}`}
    class="flex flex-col h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-2xl"
    aria-label={`View ${trek.name}`}
  >
    <div class="relative overflow-hidden aspect-[4/3] bg-neutral-100">
      <img
        src={featuredImage}
        alt={trek.name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="lazy"
        width="480"
        height="360"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-black/20 pointer-events-none"></div>

      <span class={`absolute top-3 left-3 z-10 inline-flex px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wide shadow-sm ${badgeClass}`}>
        {difficultyInfo.label}
      </span>

      <span
        class="absolute top-3 right-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-neutral-400 shadow-sm pointer-events-none"
        aria-hidden="true"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </span>
    </div>

    <div class="p-4 sm:p-5 flex flex-col flex-grow">
      <h3 class="text-base sm:text-lg font-bold text-secondary-700 group-hover:text-primary-600 transition-colors line-clamp-1 mb-1.5">
        {trek.name}
      </h3>

      <p class="flex items-center gap-1 text-xs text-neutral-500 mb-3">
        <svg class="w-3.5 h-3.5 text-primary-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="truncate">{locationDisplay}</span>
      </p>

      <div class="flex items-center gap-3 text-xs text-neutral-600 mb-4">
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2" stroke-width="1.8" />
            <path d="M8 3v4m8-4v4M7 11h10" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          {durationDays} Days
        </span>
        {distance > 0 && (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            {distance} km
          </span>
        )}
      </div>

      <div class="mt-auto pt-3 border-t border-neutral-100 flex items-center justify-between gap-2">
        <div class="min-w-0">
          <span class="text-base sm:text-lg font-extrabold text-secondary-700">{formatPrice(trek.price)}</span>
          <span class="text-xs text-neutral-400 ml-0.5">/person</span>
        </div>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-500 text-white shadow-md shadow-primary-500/30 group-hover:bg-primary-600 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>
