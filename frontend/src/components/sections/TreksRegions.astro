---
import { api } from '@/lib/api';

export interface RegionItem {
  name: string;
  slug: string;
  image: string;
  count: number;
}

interface Props {
  regions: RegionItem[];
}

interface PageSection {
  title?: string | null;
  badge_text?: string | null;
  cta_label?: string | null;
  cta_url?: string | null;
  body_html?: string | null;
}

const { regions } = Astro.props;

let title = 'Explore by Himalayan Region';
let ctaLabel = 'Explore All Regions';
let ctaUrl = '#trek-catalog';
let regionOverrides: RegionItem[] | null = null;

try {
  const section = await api.get<PageSection>('/content/treks/regions');
  if (section?.title) title = section.title;
  if (section?.cta_label) ctaLabel = section.cta_label;
  if (section?.cta_url) ctaUrl = section.cta_url;
  if (section?.body_html) {
    try {
      const parsed = JSON.parse(section.body_html) as RegionItem[];
      if (Array.isArray(parsed) && parsed.length > 0) regionOverrides = parsed;
    } catch {
      // ignore
    }
  }
} catch {
  // defaults
}

const displayRegions = (regionOverrides || regions).slice(0, 4);
---

<section class="section bg-neutral-50 border-t border-neutral-100">
  <div class="container-custom">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8 sm:mb-10">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-secondary-700">
        {title}
      </h2>
      <a
        href={ctaUrl}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors shrink-0"
      >
        {ctaLabel}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {displayRegions.map((region) => (
        <a
          href={`/treks?location=${encodeURIComponent(region.slug)}&page=1#trek-catalog`}
          class="group relative aspect-[5/4] sm:aspect-[4/3] rounded-2xl overflow-hidden block shadow-sm hover:shadow-lg transition-all duration-300"
        >
          <img
            src={region.image}
            alt={region.name}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="lazy"
            width="400"
            height="300"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/35 to-black/10"></div>
          <div class="absolute bottom-0 left-0 right-0 p-3.5 sm:p-5">
            <h3 class="text-sm sm:text-lg font-bold text-white mb-0.5 sm:mb-1">{region.name}</h3>
            <span class="text-white/85 text-xs sm:text-sm font-medium">
              {region.count > 0 ? `${region.count}+ treks` : 'Explore trails'}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
