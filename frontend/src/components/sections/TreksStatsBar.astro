---
import { api } from '@/lib/api';

interface StatItem {
  value: string;
  label: string;
  icon?: string;
}

const defaultStats: StatItem[] = [
  { value: '10,000+', label: 'Happy Trekkers', icon: 'users' },
  { value: '4.8', label: 'Average Rating', icon: 'star' },
  { value: '8+', label: 'Years Experience', icon: 'award' },
  { value: '100%', label: 'Safety Focused', icon: 'shield' },
];

let stats = defaultStats;

try {
  const section = await api.get<{ body_html?: string | null }>('/content/treks/stats');
  if (section?.body_html) {
    const parsed = JSON.parse(section.body_html) as StatItem[];
    if (Array.isArray(parsed) && parsed.length > 0) stats = parsed;
  }
} catch {
  // defaults
}
---

<section class="bg-[#F6F1EA] border-y border-neutral-200/60">
  <div class="container-custom py-10 sm:py-12">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {stats.map((stat) => (
        <div class="flex flex-col sm:flex-row items-center sm:items-center gap-3 text-center sm:text-left justify-center">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-primary-500 shadow-sm border border-primary-100">
            {stat.icon === 'star' ? (
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ) : stat.icon === 'shield' ? (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m9 12 2 2 4-4" />
              </svg>
            ) : stat.icon === 'award' ? (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="5" stroke-width="1.8" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 13.5 7 21l5-2.5L17 21l-1.5-7.5" />
              </svg>
            ) : (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                <circle cx="9" cy="7" r="4" stroke-width="1.8" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
              </svg>
            )}
          </span>
          <div>
            <div class="text-xl sm:text-2xl font-extrabold text-secondary-700 leading-tight">{stat.value}</div>
            <div class="text-xs sm:text-sm text-neutral-500 font-medium">{stat.label}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
