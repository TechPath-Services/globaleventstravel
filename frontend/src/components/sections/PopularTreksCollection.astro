---
import type { Trek } from '@/lib/types';
import TrekCardPopular from '@/components/trek/TrekCardPopular.astro';
import { api } from '@/lib/api';

interface Props {
  treks: Trek[];
}

interface PageSection {
  title?: string | null;
  subtitle?: string | null;
  badge_text?: string | null;
  cta_label?: string | null;
  cta_url?: string | null;
}

const { treks } = Astro.props;

let badge = 'TREK COLLECTION';
let title = 'Popular Himalayan Treks';
let ctaLabel = 'View All Treks';
let ctaUrl = '#trek-catalog';

try {
  const section = await api.get<PageSection>('/content/treks/popular_collection');
  if (section?.badge_text) badge = section.badge_text;
  if (section?.title) title = section.title;
  if (section?.cta_label) ctaLabel = section.cta_label;
  if (section?.cta_url) ctaUrl = section.cta_url;
} catch {
  // defaults
}

const displayTreks = treks.slice(0, 4);
---

{displayTreks.length > 0 && (
  <section id="popular-treks" class="section bg-white scroll-mt-20">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8 sm:mb-10">
        <div>
          <span class="inline-block text-primary-500 font-semibold text-xs sm:text-sm uppercase tracking-[0.18em] mb-2">
            {badge}
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-secondary-700">
            {title}
          </h2>
        </div>
        <a
          href={ctaUrl}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors shrink-0"
        >
          {ctaLabel}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Desktop: 4-col grid · Tablet/Mobile: horizontal snap carousel -->
      <div class="hidden lg:grid lg:grid-cols-4 gap-5 xl:gap-6">
        {displayTreks.map((trek) => (
          <TrekCardPopular trek={trek} />
        ))}
      </div>

      <div class="lg:hidden -mx-4 px-4 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth">
        <div class="flex gap-4 min-w-min">
          {displayTreks.map((trek) => (
            <div class="w-[78vw] sm:w-[46vw] max-w-sm shrink-0 snap-start">
              <TrekCardPopular trek={trek} />
            </div>
          ))}
        </div>
      </div>

      <div class="lg:hidden flex justify-center gap-1.5 mt-5" aria-hidden="true">
        {displayTreks.map((_, i) => (
          <span class={`h-1.5 rounded-full ${i === 0 ? 'w-5 bg-primary-500' : 'w-1.5 bg-neutral-300'}`}></span>
        ))}
      </div>
    </div>
  </section>
)}
