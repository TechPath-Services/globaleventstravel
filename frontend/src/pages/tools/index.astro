---
import MainLayout from '@/layouts/MainLayout.astro';
import { discountHeadline } from '@/lib/marketing/discount';
import { breadcrumbJsonLd, graph, loadCities, loadSettings } from '@/lib/marketing/server';

export const prerender = false;

const [settings, cities] = await Promise.all([loadSettings(), loadCities()]);
const student = settings?.student_discount;

const tools = [
  settings?.quiz.enabled !== false && {
    href: '/tools/winter-trek-quiz/',
    title: settings?.quiz.title ?? 'Which winter trek suits you?',
    text: '8 questions, 60 seconds. An honest trek pick based on your fitness, days and budget.',
    cta: 'Take the quiz',
  },
  settings?.calculator.enabled !== false && {
    href: '/tools/trek-budget-calculator/',
    title: 'Trek budget calculator',
    text: 'Package, travel from your city, stays, gear and extras in one shareable breakdown.',
    cta: 'Work out my cost',
  },
  student?.enabled && {
    href: '/student-discount/',
    title: `Student discount: ${discountHeadline(student)}`,
    text: 'Show a valid student ID and save on any open batch.',
    cta: 'Claim the discount',
  },
  cities.length > 0 && {
    href: '/treks-from/',
    title: 'Treks from your city',
    text: `Verified routes, timings and fares from ${cities.map((c) => c.name).join(', ')}.`,
    cta: 'Find my route',
  },
].filter(Boolean) as { href: string; title: string; text: string; cta: string }[];
---

<MainLayout
  title="Free Trek Planning Tools"
  description="Find your winter trek, work out the real cost, check verified routes from your city and claim student discounts."
  structuredData={graph(breadcrumbJsonLd(Astro.url.origin, [
    { name: 'Home', path: '/' },
    { name: 'Trek planning tools', path: '/tools/' },
  ]))}
>
  <section class="bg-gradient-to-br from-secondary-700 to-secondary-500 py-14 md:py-20">
    <div class="container-custom text-white">
      <h1 class="mb-3 text-4xl font-bold text-white md:text-5xl">Plan your trek</h1>
      <p class="max-w-2xl text-lg text-white/85">Free tools to pick the right trek, budget it honestly and get there.</p>
    </div>
  </section>
  <section class="section bg-neutral-50">
    <div class="container-custom grid gap-6 md:grid-cols-2">
      {tools.map((tool) => (
        <a href={tool.href} class="group block rounded-2xl border border-neutral-200 bg-white p-8 transition-shadow hover:shadow-lg">
          <h2 class="mb-2 text-2xl font-bold group-hover:text-primary-600">{tool.title}</h2>
          <p class="mb-4 text-neutral-700">{tool.text}</p>
          <span class="font-semibold text-primary-600">{tool.cta} →</span>
        </a>
      ))}
    </div>
  </section>
</MainLayout>
