---
import MainLayout from '@/layouts/MainLayout.astro';
import TrekCard from '@/components/trek/TrekCard.astro';
import ShareButtons from '@/components/tools/ShareButtons';
import MarketingLeadForm from '@/components/tools/MarketingLeadForm';
import { DIFFICULTY_LABELS } from '@/lib/constants';
import { formatDate, formatInr, sameBase } from '@/lib/marketing/format';
import { studentDiscountAmount } from '@/lib/marketing/discount';
import {
  hasOpenBatch,
  lowestPrice,
  parseAnswers,
  personaFor,
  rankTreks,
  shareLineFor,
} from '@/lib/marketing/quiz';
import {
  asTrekCard,
  breadcrumbJsonLd,
  graph,
  loadCities,
  loadSettings,
  loadTreks,
} from '@/lib/marketing/server';

export const prerender = false;

const { slug } = Astro.params;
const [settings, quizTreks, cities] = await Promise.all([loadSettings(), loadTreks('quiz'), loadCities()]);

let trek = quizTreks.find((t) => t.slug === slug);
if (!trek) {
  const allTreks = await loadTreks('all');
  trek = allTreks.find((t) => t.slug === slug);
}
if (!trek) {
  return Astro.redirect('/tools/winter-trek-quiz/');
}

const answers = parseAnswers(Astro.url.searchParams);
const ranking = answers ? rankTreks(quizTreks, answers) : null;
const reasons = ranking?.ranked.find((s) => s.trek.slug === trek.slug)?.reasons ?? [];
const alternates = ranking
  ? ranking.ranked.filter((s) => s.trek.slug !== trek.slug).slice(0, 2).map((s) => s.trek)
  : quizTreks
      .filter((t) => t.slug !== trek.slug)
      .sort((a, b) => Number(b.difficulty === trek.difficulty) - Number(a.difficulty === trek.difficulty))
      .slice(0, 2);

const persona = personaFor(trek);
const shareLine = shareLineFor(trek);
const startingPrice = lowestPrice(trek);
const nextBatch = trek.upcoming_batches.find((b) => !b.is_sold_out);
const student = settings?.student_discount;
const studentSaving = student ? studentDiscountAmount(startingPrice, student) : 0;

const servingCities = cities.filter((c) => c.bases.some((b) => sameBase(b, trek.pickup_city)));
const fromCity = answers ? servingCities.find((c) => c.slug === answers.from) : undefined;
const calculatorHref = `/tools/trek-budget-calculator/?trek=${trek.slug}${answers && answers.from !== 'other' ? `&from=${answers.from}` : ''}`;

const resultPath = `/tools/winter-trek-quiz/result/${trek.slug}/`;
const shareUrl = new URL(resultPath, Astro.url.origin).href;
const quizUrl = new URL('/tools/winter-trek-quiz/', Astro.url.origin).href;
const shareText = `${shareLine} Which winter trek are you?`;
const leadNotes = `Quiz result: ${persona} (${trek.slug})${answers ? ` | answers: ${new URLSearchParams(answers as unknown as Record<string, string>).toString()}` : ''}`;

const structuredData = graph(
  breadcrumbJsonLd(Astro.url.origin, [
    { name: 'Home', path: '/' },
    { name: 'Winter trek quiz', path: '/tools/winter-trek-quiz/' },
    { name: persona, path: resultPath },
  ]),
  {
    '@type': 'TouristTrip',
    name: trek.name,
    description: trek.short_description ?? undefined,
    touristType: persona,
    url: new URL(`/treks/${trek.slug}`, Astro.url.origin).href,
    offers: { '@type': 'Offer', price: startingPrice, priceCurrency: 'INR' },
  },
);
---

<MainLayout
  title={`${persona}: ${trek.name}`}
  description={`${shareLine} Take the 60-second winter trek quiz to find yours.`}
  ogImage={trek.featured_image || undefined}
  structuredData={structuredData}
>
  <section class="relative overflow-hidden bg-secondary-700">
    {trek.featured_image && (
      <img src={trek.featured_image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" loading="eager" />
    )}
    <div class="container-custom relative py-14 text-white md:py-20">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary-300">{answers ? 'Your winter trek match' : 'Winter trek quiz result'}</p>
      <h1 class="mb-3 text-4xl font-bold text-white md:text-5xl">{persona}</h1>
      <p class="text-xl text-white/90">
        {answers ? 'Your trek:' : 'Trek:'} <strong>{trek.name}</strong> · {trek.max_altitude.toLocaleString('en-IN')} m · {trek.duration} days{trek.pickup_city ? ` from ${trek.pickup_city}` : ''}
      </p>
      <div class="mt-6">
        <ShareButtons client:idle url={shareUrl} text={shareText} event="quiz_share" eventProps={{ result: trek.slug }} />
      </div>
      {!answers && (
        <a href="/tools/winter-trek-quiz/" class="btn-primary mt-6">Take the quiz to find your trek</a>
      )}
    </div>
  </section>

  <section class="section bg-neutral-50">
    <div class="container-custom grid gap-8 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        {reasons.length > 0 && (
          <div class="rounded-xl border border-neutral-200 bg-white p-6">
            <h2 class="mb-3 text-2xl font-bold">Why it fits you</h2>
            <ul class="space-y-2 text-neutral-700">
              {reasons.map((r) => <li>✓ {r}</li>)}
            </ul>
          </div>
        )}

        <div class="rounded-xl border border-neutral-200 bg-white p-6">
          <h2 class="mb-3 text-2xl font-bold">What to expect</h2>
          {trek.short_description && <p class="mb-4 text-neutral-700">{trek.short_description}</p>}
          <dl class="grid grid-cols-2 gap-4 text-sm md:grid-cols-4">
            <div><dt class="text-neutral-500">Difficulty</dt><dd class="font-semibold">{DIFFICULTY_LABELS[trek.difficulty]?.label ?? trek.difficulty}</dd></div>
            <div><dt class="text-neutral-500">Duration</dt><dd class="font-semibold">{trek.duration} days</dd></div>
            <div><dt class="text-neutral-500">Max altitude</dt><dd class="font-semibold">{trek.max_altitude.toLocaleString('en-IN')} m</dd></div>
            <div><dt class="text-neutral-500">Best months</dt><dd class="font-semibold">{trek.best_season.map((m) => m.slice(0, 3)).join(', ')}</dd></div>
          </dl>
          <a href={`/treks/${trek.slug}`} class="btn-secondary mt-6">Full itinerary &amp; dates</a>
        </div>

        <div class="rounded-xl border border-neutral-200 bg-white p-6">
          <h2 class="mb-3 text-2xl font-bold">Getting there</h2>
          {trek.pickup_city ? (
            <p class="mb-4 text-neutral-700">
              Pickup is in <strong>{trek.pickup_city}</strong>{trek.pickup_time ? ` at ${trek.pickup_time}` : ''}.
              {fromCity && ` We've verified routes from ${fromCity.name}.`}
            </p>
          ) : (
            <p class="mb-4 text-neutral-700">Our team shares the pickup point and timing when you enquire.</p>
          )}
          {servingCities.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {servingCities.map((c) => (
                <a href={`/treks-from/${c.slug}/`} class={`rounded-full border px-4 py-1.5 text-sm font-medium ${fromCity?.slug === c.slug ? 'border-primary-500 bg-primary-50 text-primary-700' : 'border-neutral-300 text-neutral-700 hover:border-primary-300'}`}>
                  From {c.name} →
                </a>
              ))}
            </div>
          )}
        </div>

        {alternates.length > 0 && (
          <div>
            <h2 class="mb-4 text-2xl font-bold">Also great for you</h2>
            <div class="grid gap-6 md:grid-cols-2">
              {alternates.map((t) => <TrekCard trek={asTrekCard(t)} />)}
            </div>
          </div>
        )}
      </div>

      <aside class="space-y-4">
        <div class="rounded-xl border border-neutral-200 bg-white p-6">
          <p class="text-sm text-neutral-500">Starting from</p>
          <p class="text-3xl font-bold text-neutral-900">{formatInr(startingPrice)}</p>
          {nextBatch ? (
            <p class="mt-1 text-sm text-neutral-600">Next batch {formatDate(nextBatch.start_date)} · {nextBatch.available_seats} seats left</p>
          ) : (
            <p class="mt-1 text-sm text-amber-700">{hasOpenBatch(trek) ? '' : 'New batches open soon — ask us on WhatsApp.'}</p>
          )}
          {studentSaving > 0 && (
            <a href="/student-discount/" class="mt-3 block rounded-lg bg-green-50 px-3 py-2 text-sm font-medium text-green-800">
              Students pay {formatInr(startingPrice - studentSaving)} →
            </a>
          )}
          <a href={calculatorHref} class="btn-ghost mt-3 w-full">What will it cost me all-in?</a>
        </div>

        <MarketingLeadForm
          client:idle
          source="quiz_winter"
          title="Send me this plan on WhatsApp"
          subtitle="Itinerary, packing list and upcoming dates."
          ctaLabel="Send my plan"
          successMessage={`We'll WhatsApp your ${trek.name} plan shortly.`}
          trekSlug={trek.slug}
          trekName={trek.name}
          notes={leadNotes}
        />

        <p class="text-center text-sm text-neutral-600">
          Not you? <a href={quizUrl} class="underline">Retake the quiz</a>
        </p>
      </aside>
    </div>
  </section>
</MainLayout>
