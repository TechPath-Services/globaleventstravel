---
import MainLayout from '@/layouts/MainLayout.astro';
import WinterTrekQuiz from '@/components/tools/WinterTrekQuiz';
import { DIFFICULTY_LABELS } from '@/lib/constants';
import { formatInr } from '@/lib/marketing/format';
import { lowestPrice } from '@/lib/marketing/quiz';
import {
  breadcrumbJsonLd,
  faqJsonLd,
  graph,
  loadCities,
  loadSettings,
  loadTreks,
} from '@/lib/marketing/server';

export const prerender = false;

const [settings, treks, cities] = await Promise.all([loadSettings(), loadTreks('quiz'), loadCities()]);
const quiz = settings?.quiz;
const enabled = !!quiz?.enabled && treks.length > 0;
const months = quiz?.season_months ?? [];
const seasonLabel = months.length > 1 ? `${months[0]} – ${months[months.length - 1]}` : months[0] ?? 'Winter';
const title = quiz?.title ?? 'Which winter trek suits you?';
const subtitle = quiz?.subtitle ?? '';

const byDifficulty = (d: string) => treks.filter((t) => t.difficulty === d).map((t) => t.name);
const shortTreks = treks.filter((t) => t.duration <= 3).map((t) => t.name);
const listText = (names: string[]) =>
  names.length <= 1 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;

const faqs = [
  byDifficulty('easy').length > 0 && {
    question: 'Which winter trek is best for beginners?',
    answer: `Our easiest winter treks this season are ${listText(byDifficulty('easy'))}. They need basic fitness and no previous Himalayan experience. The quiz also weighs your fitness, days and budget.`,
  },
  {
    question: 'Can I do a winter trek in a long weekend?',
    answer: shortTreks.length
      ? `Yes. ${listText(shortTreks)} can be done in 2–3 days from the pickup point.`
      : 'Most of our winter treks need 5–6 days including travel. The quiz shows the shortest option that fits you.',
  },
  {
    question: 'How cold does it get on winter treks?',
    answer: 'Expect daytime temperatures around 0–10 °C and nights from −5 °C to −15 °C at higher camps in January and February. Proper layers and a warm sleeping bag matter more than anything else.',
  },
  {
    question: 'How does the quiz pick my trek?',
    answer: 'It scores every open winter trek on what you want to experience, the days you have, your experience and fitness, how much cold you can take and your budget. Treks well beyond your level are never recommended.',
  },
].filter(Boolean) as { question: string; answer: string }[];

const structuredData = graph(
  {
    '@type': 'WebApplication',
    name: title,
    applicationCategory: 'TravelApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    url: new URL('/tools/winter-trek-quiz/', Astro.url.origin).href,
  },
  faqJsonLd(faqs),
  breadcrumbJsonLd(Astro.url.origin, [
    { name: 'Home', path: '/' },
    { name: 'Trek planning tools', path: '/tools/' },
    { name: title, path: '/tools/winter-trek-quiz/' },
  ]),
);
---

<MainLayout
  title="Which Winter Trek Suits You? 60-Second Quiz"
  description={`${listText(treks.slice(0, 3).map((t) => t.name)) || 'Kedarkantha, Brahmatal'} or something else? Answer 8 quick questions about your experience, fitness, days and budget to get an honest winter trek pick.`}
  structuredData={structuredData}
>
  <section class="bg-gradient-to-br from-secondary-700 via-secondary-600 to-secondary-500 py-14 md:py-20">
    <div class="container-custom grid items-start gap-10 lg:grid-cols-2">
      <div class="text-white">
        <p class="mb-3 inline-block rounded-full bg-white/15 px-3 py-1 text-sm font-medium text-white">Free trek finder · {seasonLabel}</p>
        <h1 class="mb-4 text-4xl font-bold text-white md:text-5xl">{title}</h1>
        <p class="text-lg text-white/85">{subtitle}</p>
        <ul class="mt-6 space-y-2 text-white/85">
          <li>✓ Picks only from treks with this season's departures</li>
          <li>✓ Never pushes you beyond your experience</li>
          <li>✓ Shows how to reach it from your city and what it really costs</li>
        </ul>
      </div>
      <div>
        {enabled ? (
          <WinterTrekQuiz
            client:load
            treks={treks}
            cities={cities.map((c) => ({ slug: c.slug, name: c.name }))}
            resultBasePath="/tools/winter-trek-quiz/result/"
          />
        ) : (
          <div class="rounded-2xl bg-white p-8 text-center shadow-lg">
            <p class="text-lg font-semibold text-neutral-900">The trek finder is taking a short break.</p>
            <p class="mt-2 text-neutral-600">Browse all treks or ask our team on WhatsApp for a recommendation.</p>
            <a href="/treks" class="btn-primary mt-5">Browse treks</a>
          </div>
        )}
      </div>
    </div>
  </section>

  {treks.length > 0 && (
    <section class="section bg-white">
      <div class="container-custom">
        <h2 class="mb-2 text-3xl font-bold">This season's winter treks at a glance</h2>
        <p class="mb-8 text-neutral-600">Every trek the quiz can recommend, with live starting prices.</p>
        <div class="overflow-x-auto rounded-xl border border-neutral-200">
          <table class="w-full min-w-[640px] text-left text-sm">
            <thead class="bg-neutral-50 text-neutral-600">
              <tr>
                <th class="px-4 py-3 font-semibold">Trek</th>
                <th class="px-4 py-3 font-semibold">Region</th>
                <th class="px-4 py-3 font-semibold">Days</th>
                <th class="px-4 py-3 font-semibold">Max altitude</th>
                <th class="px-4 py-3 font-semibold">Difficulty</th>
                <th class="px-4 py-3 font-semibold">Pickup</th>
                <th class="px-4 py-3 font-semibold">From</th>
              </tr>
            </thead>
            <tbody>
              {treks.map((t) => (
                <tr class="border-t border-neutral-100">
                  <td class="px-4 py-3 font-medium"><a href={`/treks/${t.slug}`}>{t.name}</a></td>
                  <td class="px-4 py-3 text-neutral-700">{t.region ?? t.location}</td>
                  <td class="px-4 py-3 text-neutral-700">{t.duration}</td>
                  <td class="px-4 py-3 text-neutral-700">{t.max_altitude.toLocaleString('en-IN')} m</td>
                  <td class="px-4 py-3 text-neutral-700">{DIFFICULTY_LABELS[t.difficulty]?.label ?? t.difficulty}</td>
                  <td class="px-4 py-3 text-neutral-700">{t.pickup_city ?? '—'}</td>
                  <td class="px-4 py-3 font-semibold text-neutral-900">{formatInr(lowestPrice(t))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="section bg-neutral-50">
    <div class="container-custom max-w-3xl">
      <h2 class="mb-6 text-3xl font-bold">Questions trekkers ask</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-neutral-200 bg-white p-5">
            <summary class="cursor-pointer list-none font-semibold text-neutral-900">{faq.question}</summary>
            <p class="mt-3 text-neutral-700">{faq.answer}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-sm text-neutral-600">
        Writing about winter treks? You're welcome to link to this quiz. Also see our
        <a href="/tools/trek-budget-calculator/" class="underline">trek budget calculator</a>.
      </p>
    </div>
  </section>
</MainLayout>
