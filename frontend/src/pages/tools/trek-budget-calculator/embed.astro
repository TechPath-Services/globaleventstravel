---
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import BudgetCalculator from '@/components/tools/BudgetCalculator';
import { loadCities, loadCityDetails, loadSettings, loadTreks } from '@/lib/marketing/server';
import { DEFAULT_SETTINGS_FALLBACK } from '@/lib/marketing/defaults';

export const prerender = false;

Astro.response.headers.set('Content-Security-Policy', 'frame-ancestors *');

const [settings, treks, citySummaries] = await Promise.all([loadSettings(), loadTreks('all'), loadCities()]);
const cityDetails = await loadCityDetails(citySummaries);
const calculator = settings?.calculator ?? DEFAULT_SETTINGS_FALLBACK.calculator;
const student = settings?.student_discount ?? DEFAULT_SETTINGS_FALLBACK.student_discount;
const pageUrl = new URL('/tools/trek-budget-calculator/', Astro.url.origin).href;
---

<EmbedLayout title="Trek budget calculator">
  {calculator.enabled && treks.length > 0 ? (
    <BudgetCalculator
      client:load
      embed
      treks={treks}
      cities={cityDetails.map((c) => ({ slug: c.slug, name: c.name, routes: c.routes }))}
      calculator={calculator}
      student={student}
      initialQuery={Astro.url.search}
      fullUrl={pageUrl}
    />
  ) : (
    <p class="p-6 text-center">The calculator is being updated.</p>
  )}
  <p class="mt-3 text-center text-xs text-neutral-500">
    <a href={pageUrl} target="_blank" rel="noopener">Trek budget calculator</a> by Global Events Travels
  </p>
</EmbedLayout>
