---
import MainLayout from '@/layouts/MainLayout.astro';
import MarketingLeadForm from '@/components/tools/MarketingLeadForm';
import ShareButtons from '@/components/tools/ShareButtons';
import { DIFFICULTY_LABELS } from '@/lib/constants';
import { discountHeadline, studentPrice } from '@/lib/marketing/discount';
import { formatInr } from '@/lib/marketing/format';
import { lowestPrice } from '@/lib/marketing/quiz';
import { breadcrumbJsonLd, faqJsonLd, graph, loadSettings, loadTreks } from '@/lib/marketing/server';

export const prerender = false;

const [settings, seasonTreks, allTreks] = await Promise.all([loadSettings(), loadTreks('quiz'), loadTreks('all')]);
const offer = settings?.student_discount;
const live = offer && offer.enabled && offer.percent > 0 ? offer : null;
const headline = live ? discountHeadline(live) : '';
const showcase = (seasonTreks.length ? seasonTreks : allTreks).slice(0, 6);
const pageUrl = new URL('/student-discount/', Astro.url.origin).href;
const shareText = `Students get ${headline} Himalayan treks with a valid college ID.`;
const faqs = offer?.faqs ?? [];

const structuredData = graph(
  faqs.length > 0 && faqJsonLd(faqs),
  breadcrumbJsonLd(Astro.url.origin, [
    { name: 'Home', path: '/' },
    { name: 'Student discount', path: '/student-discount/' },
  ]),
);
---

<MainLayout
  title={live ? `Student Discount on Himalayan Treks: ${headline}` : 'Student Discount on Himalayan Treks'}
  description={live
    ? `Students get ${headline} Himalayan treks with a valid student ID. Plan your trek with your college group.`
    : 'Student offers on Himalayan treks with Global Events Travels.'}
  structuredData={structuredData}
>
  <section class="bg-gradient-to-br from-primary-600 via-primary-500 to-primary-400 py-14 md:py-20">
    <div class="container-custom grid items-center gap-10 lg:grid-cols-2">
      <div class="text-white">
        <p class="mb-3 inline-block rounded-full bg-white/20 px-3 py-1 text-sm font-semibold text-white">For college students</p>
        {live ? (
          <>
            <h1 class="mb-4 text-4xl font-bold text-white md:text-5xl">{headline} Himalayan treks</h1>
            <p class="text-lg text-white/90">
              Show a valid student ID and save on any open batch. Perfect for your college gang's next break.
            </p>
            {live.group_bonus_enabled && (
              <p class="mt-4 rounded-lg bg-white/15 px-4 py-3 text-white">
                Groups of {live.group_min_size}+ students: the organiser gets an extra {formatInr(live.group_bonus_inr)} off.
              </p>
            )}
          </>
        ) : (
          <>
            <h1 class="mb-4 text-4xl font-bold text-white md:text-5xl">Student offers</h1>
            <p class="text-lg text-white/90">Our student offer is paused right now. Leave your details and we'll tell you when it's back.</p>
          </>
        )}
        <div class="mt-6">
          <ShareButtons client:idle url={pageUrl} text={live ? shareText : 'Himalayan treks for students'} event="student_offer_share" />
        </div>
      </div>
      <div id="claim">
        <MarketingLeadForm
          client:load
          source="student_discount"
          title={live ? 'Claim your student discount' : 'Notify me'}
          subtitle={live ? `Verify on WhatsApp ${live.verification_time_text}.` : undefined}
          ctaLabel={live ? 'Claim discount' : 'Notify me'}
          successMessage="We'll message you on WhatsApp to verify your student ID."
          trekChoices={allTreks.map((t) => ({ slug: t.slug, name: t.name }))}
          extraField={{ label: 'College / university', placeholder: 'College / university name', required: true }}
        />
      </div>
    </div>
  </section>

  {live && (
    <section class="section bg-white">
      <div class="container-custom">
        <h2 class="mb-8 text-center text-3xl font-bold">How it works</h2>
        <ol class="grid gap-6 md:grid-cols-3">
          <li class="rounded-xl border border-neutral-200 p-6">
            <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 font-bold text-primary-700">1</span>
            <h3 class="mb-2 text-xl font-bold">Tell us your trek and college</h3>
            <p class="text-neutral-700">Fill the 30-second form above.</p>
          </li>
          <li class="rounded-xl border border-neutral-200 p-6">
            <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 font-bold text-primary-700">2</span>
            <h3 class="mb-2 text-xl font-bold">Verify on WhatsApp</h3>
            <p class="text-neutral-700">Send your college ID and one more proof. We reply {live.verification_time_text}.</p>
          </li>
          <li class="rounded-xl border border-neutral-200 p-6">
            <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 font-bold text-primary-700">3</span>
            <h3 class="mb-2 text-xl font-bold">Book at the student price</h3>
            <p class="text-neutral-700">Your discount is locked in for the batch you choose.</p>
          </li>
        </ol>
      </div>
    </section>
  )}

  {live && showcase.length > 0 && (
    <section class="section bg-neutral-50">
      <div class="container-custom">
        <h2 class="mb-2 text-3xl font-bold">Treks students love this season</h2>
        <p class="mb-8 text-neutral-600">Live prices from our booking system. Not sure which one? <a href="/tools/winter-trek-quiz/" class="underline">Take the 60-second quiz</a>.</p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {showcase.map((t) => {
            const price = lowestPrice(t);
            return (
              <a href={`/treks/${t.slug}`} class="block rounded-xl border border-neutral-200 bg-white p-5 transition-shadow hover:shadow-md">
                <p class="text-lg font-bold text-secondary-600">{t.name}</p>
                <p class="text-sm text-neutral-600">
                  {DIFFICULTY_LABELS[t.difficulty]?.label ?? t.difficulty} · {t.duration} days{t.pickup_city ? ` · from ${t.pickup_city}` : ''}
                </p>
                <p class="mt-3">
                  <span class="text-neutral-500 line-through">{formatInr(price)}</span>
                  <span class="ml-2 text-2xl font-bold text-green-700">{formatInr(studentPrice(price, live))}</span>
                  <span class="text-sm text-neutral-500"> for students</span>
                </p>
              </a>
            );
          })}
        </div>
        <p class="mt-6 text-sm text-neutral-600">
          Convincing your group? Send them the <a href="/tools/trek-budget-calculator/" class="underline">budget calculator</a> with your exact plan.
        </p>
      </div>
    </section>
  )}

  {live && (
    <section class="section bg-white">
      <div class="container-custom grid gap-10 lg:grid-cols-2">
        {faqs.length > 0 && (
          <div>
            <h2 class="mb-6 text-3xl font-bold">FAQ</h2>
            <div class="space-y-3">
              {faqs.map((faq) => (
                <details class="rounded-xl border border-neutral-200 p-5">
                  <summary class="cursor-pointer list-none font-semibold text-neutral-900">{faq.question}</summary>
                  <p class="mt-3 text-neutral-700">{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )}
        {live.terms.length > 0 && (
          <div>
            <h2 class="mb-6 text-3xl font-bold">Terms</h2>
            <ul class="list-disc space-y-2 pl-5 text-neutral-700">
              {live.terms.map((term) => <li>{term}</li>)}
            </ul>
            <p class="mt-4 text-sm text-neutral-600">
              Also see our <a href="/cancellation-refund" class="underline">cancellation &amp; refund policy</a>.
            </p>
          </div>
        )}
      </div>
    </section>
  )}
</MainLayout>
