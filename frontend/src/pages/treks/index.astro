---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroTreks from '@/components/hero/HeroTreks.astro';
import PopularTreksCollection from '@/components/sections/PopularTreksCollection.astro';
import TreksRegions from '@/components/sections/TreksRegions.astro';
import TreksStatsBar from '@/components/sections/TreksStatsBar.astro';
import TrekGrid from '@/components/trek/TrekGrid.astro';
import WhyChooseUs from '@/components/sections/WhyChooseUs.astro';
import GoogleReviews from '@/components/sections/GoogleReviews';
import { DIFFICULTY_LABELS } from '@/lib/constants';
import { treksApi } from '@/lib/api';
import type { Trek } from '@/lib/types';

// Region slug -> image mapping (fallback for derived regions)
const REGION_IMAGE_MAP: Record<string, string> = {
  'Uttarakhand': '/images/destinations/uttarakhand.jpg',
  'Himachal Pradesh': '/images/destinations/himachal.jpg',
  'Himachal': '/images/destinations/himachal.jpg',
  'Kashmir': '/images/destinations/uttarkashi.jpg',
  'Sikkim': '/images/destinations/himachal.jpg',
};

// Enable SSR for dynamic query param filtering
export const prerender = false;

// Pagination configuration
const ITEMS_PER_PAGE = 9;
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8000';

function parseDurationRange(raw?: string | null): { min?: number; max?: number } {
  if (!raw) return {};
  if (raw.endsWith('+')) {
    const min = parseInt(raw.slice(0, -1), 10);
    return Number.isFinite(min) ? { min } : {};
  }
  const [minStr, maxStr] = raw.split('-');
  const min = parseInt(minStr, 10);
  const max = parseInt(maxStr, 10);
  const result: { min?: number; max?: number } = {};
  if (Number.isFinite(min)) result.min = min;
  if (Number.isFinite(max)) result.max = max;
  return result;
}

// Get URL query parameters
const url = Astro.url;
const currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10) || 1);
const difficulty = url.searchParams.get('difficulty') || undefined;
const season = url.searchParams.get('season') || undefined;
const maxPrice = url.searchParams.get('max_price') || undefined;
const location = url.searchParams.get('location') || undefined;
const sort = url.searchParams.get('sort') || undefined;
const search = url.searchParams.get('search') || undefined;
const duration = url.searchParams.get('duration') || undefined;
const { min: minDuration, max: maxDuration } = parseDurationRange(duration);

// Build API URL with filters for backend consumption
const apiParams = new URLSearchParams();
apiParams.set('skip', String((currentPage - 1) * ITEMS_PER_PAGE));
apiParams.set('limit', String(ITEMS_PER_PAGE));
apiParams.set('status', 'published');
if (difficulty) apiParams.set('difficulty', difficulty);
if (season) apiParams.set('season', season);
if (maxPrice) apiParams.set('max_price', maxPrice);
if (location) apiParams.set('location', location);
if (sort) apiParams.set('sort', sort);
if (search) apiParams.set('search', search);
if (minDuration) apiParams.set('min_duration', String(minDuration));
if (maxDuration) apiParams.set('max_duration', String(maxDuration));

// State variables for rendered data
let treks: any[] = [];
let totalItems = 0;
let totalPages = 1;
let allSeasons: string[] = [];
let allTreks: any[] = [];
let derivedRegions: { name: string; slug: string; image: string; count: number }[] = [];
let budgetTiers: { label: string; value: string }[] = [];

try {
  const response = await fetch(`${API_BASE_URL}/api/v1/treks?${apiParams.toString()}`);
  if (response.ok) {
    const data = await response.json();
    treks = data.items || [];
    totalItems = data.total || 0;
    totalPages = Math.max(1, Math.ceil(totalItems / ITEMS_PER_PAGE));
  }

  // Fetch all treks to dynamically populate filter facets and regions
  const allTreksResponse = await fetch(`${API_BASE_URL}/api/v1/treks?limit=100&status=published`);
  if (allTreksResponse.ok) {
    const allData = await allTreksResponse.json();
    allTreks = allData.items || [];
    allSeasons = [...new Set(allTreks.flatMap((t: any) => t.best_season || []))].sort() as string[];

    // Derive regions from unique location values (extract state/region part after comma)
    const locationCounts: Record<string, number> = {};
    for (const t of allTreks) {
      const loc = (t.location || '').trim();
      if (!loc) continue;
      const regionName = loc.includes(',') ? loc.split(',').pop()!.trim() : loc;
      locationCounts[regionName] = (locationCounts[regionName] || 0) + 1;
    }
    derivedRegions = Object.entries(locationCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 6)
      .map(([name, count]) => ({
        name,
        slug: name,
        image: REGION_IMAGE_MAP[name] || REGION_IMAGE_MAP[name.split(' ')[0]] || '/images/destinations/uttarakhand.jpg',
        count,
      }));

    // Derive budget tiers based on dataset pricing
    const prices = allTreks.map((t: any) => t.price || 0).filter((p: number) => p > 0);
    const maxP = prices.length ? Math.max(...prices) : 50000;
    const defaultTiers = [10000, 20000, 30000, 50000];
    const relevantTiers = defaultTiers.filter((v) => v <= Math.max(maxP, 50000));
    budgetTiers = [
      { label: 'Any Budget', value: '' },
      ...(relevantTiers.length > 0 ? relevantTiers : [Math.ceil(maxP / 10000) * 10000 || 20000]).map((v: number) => ({
        label: `Under ₹${(v / 1000).toFixed(0)}K`,
        value: String(v),
      })),
    ];
  }
} catch (error) {
  console.error('Failed to fetch treks:', error);
}

// Robust default fallbacks
if (derivedRegions.length === 0) {
  derivedRegions = [
    { name: 'Uttarakhand', slug: 'Uttarakhand', image: '/images/destinations/uttarakhand.jpg', count: 0 },
    { name: 'Himachal Pradesh', slug: 'Himachal', image: '/images/destinations/himachal.jpg', count: 0 },
    { name: 'Kashmir', slug: 'Kashmir', image: '/images/destinations/srinagar.jpg', count: 0 },
  ];
}
if (budgetTiers.length <= 1) {
  budgetTiers = [
    { label: 'Any Budget', value: '' },
    { label: 'Under ₹10K', value: '10000' },
    { label: 'Under ₹20K', value: '20000' },
    { label: 'Under ₹30K', value: '30000' },
    { label: 'Under ₹50K', value: '50000' },
  ];
}

// Build URL for pagination preservation
const buildPageUrl = (page: number) => {
  const params = new URLSearchParams();
  params.set('page', String(page));
  if (difficulty) params.set('difficulty', difficulty);
  if (season) params.set('season', season);
  if (maxPrice) params.set('max_price', maxPrice);
  if (location) params.set('location', location);
  if (sort) params.set('sort', sort);
  if (search) params.set('search', search);
  if (duration) params.set('duration', duration);
  return `/treks?${params.toString()}`;
};

// Build URL for modifying filters (resets page to 1)
const buildFilterUrl = (filters: Record<string, string | undefined>) => {
  const params = new URLSearchParams();
  params.set('page', '1');
  const allFilters = {
    difficulty,
    season,
    max_price: maxPrice,
    location,
    sort,
    search,
    duration,
    ...filters,
  };
  Object.entries(allFilters).forEach(([key, value]) => {
    if (value !== undefined && value !== '') {
      params.set(key, value);
    }
  });
  const queryString = params.toString();
  return queryString ? `/treks?${queryString}` : '/treks';
};

// Compute dynamic active filter chips
interface ActiveFilter {
  key: string;
  label: string;
  displayValue: string;
  removeUrl: string;
}

const activeFilters: ActiveFilter[] = [];

if (search) {
  activeFilters.push({
    key: 'search',
    label: 'Keyword',
    displayValue: `"${search}"`,
    removeUrl: buildFilterUrl({ search: undefined }),
  });
}

if (location) {
  activeFilters.push({
    key: 'location',
    label: 'Region',
    displayValue: location,
    removeUrl: buildFilterUrl({ location: undefined }),
  });
}

if (difficulty) {
  const diffLabel = DIFFICULTY_LABELS[difficulty]?.label || difficulty;
  activeFilters.push({
    key: 'difficulty',
    label: 'Difficulty',
    displayValue: diffLabel,
    removeUrl: buildFilterUrl({ difficulty: undefined }),
  });
}

if (maxPrice) {
  const tier = budgetTiers.find((b) => b.value === maxPrice);
  const priceLabel = tier ? tier.label : `Under ₹${(parseInt(maxPrice, 10) / 1000).toFixed(0)}K`;
  activeFilters.push({
    key: 'max_price',
    label: 'Budget',
    displayValue: priceLabel,
    removeUrl: buildFilterUrl({ max_price: undefined }),
  });
}

if (duration) {
  const durationLabels: Record<string, string> = {
    '1-3': '1–3 Days',
    '4-6': '4–6 Days',
    '7-9': '7–9 Days',
    '10+': '10+ Days',
  };
  activeFilters.push({
    key: 'duration',
    label: 'Duration',
    displayValue: durationLabels[duration] || duration,
    removeUrl: buildFilterUrl({ duration: undefined }),
  });
}

if (season) {
  activeFilters.push({
    key: 'season',
    label: 'Season',
    displayValue: season,
    removeUrl: buildFilterUrl({ season: undefined }),
  });
}

// Calculate pagination page sequence
const getPageNumbers = () => {
  const pages: (number | string)[] = [];
  const showPages = 5;

  if (totalPages <= showPages) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    pages.push(1);
    let start = Math.max(2, currentPage - 1);
    let end = Math.min(totalPages - 1, currentPage + 1);

    if (currentPage <= 3) {
      end = Math.min(4, totalPages - 1);
    } else if (currentPage >= totalPages - 2) {
      start = Math.max(2, totalPages - 3);
    }

    if (start > 2) pages.push('...');
    for (let i = start; i <= end; i++) {
      pages.push(i);
    }
    if (end < totalPages - 1) pages.push('...');
    if (totalPages > 1) pages.push(totalPages);
  }

  return pages;
};

const pageNumbers = getPageNumbers();
const startItem = totalItems > 0 ? (currentPage - 1) * ITEMS_PER_PAGE + 1 : 0;
const endItem = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);

const hasActiveSearch = Boolean(search || difficulty || duration || maxPrice || location || season);

let featuredTreks: Trek[] = [];
try {
  featuredTreks = await treksApi.getFeatured(4);
} catch (error) {
  console.error('Failed to fetch featured treks:', error);
  featuredTreks = allTreks.filter((t: any) => t.featured).slice(0, 4);
}
---

<MainLayout
  title="All Himalayan Treks & Expeditions | Global Events Travels"
  description="Browse our complete collection of Himalayan treks. Filter by difficulty, budget, season, and region to find your dream mountain adventure."
>
  <HeroTreks
    search={search}
    difficulty={difficulty}
    duration={duration}
    maxPrice={maxPrice}
    budgetTiers={budgetTiers}
  />

  {!hasActiveSearch && (
    <PopularTreksCollection treks={featuredTreks.length > 0 ? featuredTreks : (allTreks.slice(0, 4) as Trek[])} />
  )}

  {!hasActiveSearch && (
    <TreksRegions regions={derivedRegions} />
  )}

  {!hasActiveSearch && <TreksStatsBar />}

  <!-- Main Catalog Content Section -->
  <section id="trek-catalog" class="section bg-neutral-50 pt-8 sm:pt-12 scroll-mt-20">
    <div class="container-custom">
      {!hasActiveSearch && (
        <div class="mb-8 sm:mb-10">
          <span class="inline-block text-primary-500 font-semibold text-xs sm:text-sm uppercase tracking-[0.18em] mb-2">
            Full Catalog
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-secondary-700">
            All Himalayan Treks
          </h2>
        </div>
      )}
      <!-- Active Filter Chips Bar (Full Width) -->
      {activeFilters.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 mb-6 p-3.5 sm:p-4 bg-primary-50/60 border border-primary-200/70 rounded-2xl">
          <span class="text-xs font-bold uppercase tracking-wider text-neutral-600 flex items-center gap-1.5 mr-1">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            Active Filters:
          </span>

          {activeFilters.map((filter) => (
            <a
              href={filter.removeUrl}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white text-secondary-600 text-xs font-semibold border border-primary-200 hover:border-primary-400 hover:bg-primary-50 transition-all shadow-xs group"
              title={`Remove ${filter.label} filter`}
            >
              <span class="text-neutral-500 font-normal">{filter.label}:</span>
              <span>{filter.displayValue}</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:text-primary-600 transition-colors ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </a>
          ))}

          <a
            href="/treks"
            class="ml-auto text-xs font-bold text-primary-600 hover:text-primary-700 hover:underline px-2 py-1 transition-colors"
          >
            Clear All
          </a>
        </div>
      )}

      <!-- Mobile & Tablet Filter Trigger Toolbar (<1024px) -->
      <div class="lg:hidden mb-6 flex items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-neutral-200 shadow-xs">
        <button
          id="mobile-filter-open"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-neutral-100 hover:bg-neutral-200 active:bg-neutral-300 text-neutral-800 font-semibold text-xs sm:text-sm rounded-xl transition-colors min-h-[44px]"
          aria-label="Open filter drawer"
        >
          <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          <span>Filters</span>
          {activeFilters.length > 0 && (
            <span class="w-5 h-5 rounded-full bg-primary-500 text-white text-[11px] font-bold flex items-center justify-center">
              {activeFilters.length}
            </span>
          )}
        </button>

        <div class="flex items-center gap-2">
          <label for="sort-treks-mobile" class="text-xs font-medium text-neutral-500">Sort:</label>
          <select
            id="sort-treks-mobile"
            class="px-3 py-2 border border-neutral-200 rounded-xl text-xs sm:text-sm bg-white text-neutral-800 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 min-h-[44px]"
            onchange="window.location.href = this.value"
          >
            <option value={buildFilterUrl({ sort: 'newest' })} selected={sort === 'newest' || !sort}>Newest</option>
            <option value={buildFilterUrl({ sort: 'popularity' })} selected={sort === 'popularity'}>Popularity</option>
            <option value={buildFilterUrl({ sort: 'price_asc' })} selected={sort === 'price_asc'}>Price: Low to High</option>
            <option value={buildFilterUrl({ sort: 'price_desc' })} selected={sort === 'price_desc'}>Price: High to Low</option>
            <option value={buildFilterUrl({ sort: 'rating' })} selected={sort === 'rating'}>Highest Rated</option>
          </select>
        </div>
      </div>

      <!-- Main Split Grid: Desktop Sticky Sidebar + Catalog Cards -->
      <div class="lg:flex lg:gap-8 items-start">
        <!-- Desktop Sticky Filters Sidebar (hidden on mobile/tablet) -->
        <aside class="hidden lg:block lg:w-72 flex-shrink-0">
          <div class="bg-white rounded-2xl border border-neutral-200/90 p-6 sticky top-24 shadow-sm space-y-6">
            <!-- Sidebar Header -->
            <div class="flex items-center justify-between pb-4 border-b border-neutral-100">
              <h3 class="text-base font-bold text-secondary-600 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Filters
              </h3>
              {activeFilters.length > 0 && (
                <a href="/treks" class="text-xs font-semibold text-primary-600 hover:text-primary-700 hover:underline">
                  Reset All
                </a>
              )}
            </div>

            <!-- Difficulty Filter (Collapsible) -->
            <details class="group" open>
              <summary class="flex items-center justify-between font-semibold text-neutral-800 text-sm cursor-pointer list-none py-1 hover:text-secondary-600">
                <span class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  Difficulty
                </span>
                <svg class="w-4 h-4 text-neutral-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-3 space-y-1.5 pl-6">
                {Object.entries(DIFFICULTY_LABELS).map(([key, val]) => (
                  <a
                    href={buildFilterUrl({ difficulty: difficulty === key ? undefined : key })}
                    class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                      difficulty === key
                        ? 'bg-primary-500 text-white shadow-xs'
                        : 'text-neutral-700 hover:bg-neutral-50'
                    }`}
                  >
                    <span>{val.label}</span>
                    {difficulty === key && (
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    )}
                  </a>
                ))}
              </div>
            </details>

            <!-- Budget Filter (Collapsible) -->
            <details class="group" open>
              <summary class="flex items-center justify-between font-semibold text-neutral-800 text-sm cursor-pointer list-none py-1 hover:text-secondary-600">
                <span class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Budget Range
                </span>
                <svg class="w-4 h-4 text-neutral-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-3 space-y-1.5 pl-6">
                {budgetTiers.filter((t) => t.value).map((tier) => (
                  <a
                    href={buildFilterUrl({ max_price: maxPrice === tier.value ? undefined : tier.value })}
                    class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                      maxPrice === tier.value
                        ? 'bg-primary-500 text-white shadow-xs'
                        : 'text-neutral-700 hover:bg-neutral-50'
                    }`}
                  >
                    <span>{tier.label}</span>
                    {maxPrice === tier.value && (
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    )}
                  </a>
                ))}
              </div>
            </details>

            <!-- Season Filter (Collapsible) -->
            {allSeasons.length > 0 && (
              <details class="group" open>
                <summary class="flex items-center justify-between font-semibold text-neutral-800 text-sm cursor-pointer list-none py-1 hover:text-secondary-600">
                  <span class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    Season
                  </span>
                  <svg class="w-4 h-4 text-neutral-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="mt-3 flex flex-wrap gap-1.5 pl-6">
                  {allSeasons.slice(0, 8).map((s) => (
                    <a
                      href={buildFilterUrl({ season: season === s ? undefined : s })}
                      class={`px-2.5 py-1.5 rounded-lg text-xs font-semibold border transition-all ${
                        season === s
                          ? 'bg-primary-500 text-white border-primary-500 shadow-xs'
                          : 'bg-neutral-50 text-neutral-700 border-neutral-200 hover:border-neutral-300'
                      }`}
                    >
                      {s}
                    </a>
                  ))}
                </div>
              </details>
            )}

            <!-- Region Filter (Collapsible) -->
            {derivedRegions.length > 0 && (
              <details class="group" open>
                <summary class="flex items-center justify-between font-semibold text-neutral-800 text-sm cursor-pointer list-none py-1 hover:text-secondary-600">
                  <span class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Region
                  </span>
                  <svg class="w-4 h-4 text-neutral-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="mt-3 space-y-1 pl-6">
                  {derivedRegions.map((r) => (
                    <a
                      href={buildFilterUrl({ location: location === r.slug ? undefined : r.slug })}
                      class={`flex items-center justify-between px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${
                        location === r.slug
                          ? 'bg-primary-500 text-white shadow-xs'
                          : 'text-neutral-700 hover:bg-neutral-50'
                      }`}
                    >
                      <span class="truncate">{r.name}</span>
                      {r.count > 0 && (
                        <span class={`text-[10px] ${location === r.slug ? 'text-primary-100' : 'text-neutral-400'}`}>
                          ({r.count})
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </details>
            )}
          </div>
        </aside>

        <!-- Main Catalog Cards Area -->
        <div class="flex-grow min-w-0">
          <!-- Desktop Results Header & Sort Controls -->
          <div class="hidden lg:flex items-center justify-between gap-4 mb-6 bg-white p-4 rounded-2xl border border-neutral-200/90 shadow-xs">
            <p class="text-sm text-neutral-600">
              {totalItems > 0 ? (
                <>
                  Showing <span class="font-bold text-secondary-600">{startItem}–{endItem}</span> of <span class="font-bold text-secondary-600">{totalItems}</span> available treks
                </>
              ) : (
                <span class="font-medium text-neutral-700">0 treks found</span>
              )}
            </p>

            <div class="flex items-center gap-2.5">
              <label for="sort-treks-desktop" class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">
                Sort By:
              </label>
              <select
                id="sort-treks-desktop"
                class="px-3.5 py-2 border border-neutral-200 rounded-xl text-xs font-semibold bg-white text-neutral-800 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all cursor-pointer shadow-xs"
                onchange="window.location.href = this.value"
              >
                <option value={buildFilterUrl({ sort: 'newest' })} selected={sort === 'newest' || !sort}>Newest</option>
                <option value={buildFilterUrl({ sort: 'popularity' })} selected={sort === 'popularity'}>Popularity</option>
                <option value={buildFilterUrl({ sort: 'price_asc' })} selected={sort === 'price_asc'}>Price: Low to High</option>
                <option value={buildFilterUrl({ sort: 'price_desc' })} selected={sort === 'price_desc'}>Price: High to Low</option>
                <option value={buildFilterUrl({ sort: 'rating' })} selected={sort === 'rating'}>Highest Rated</option>
              </select>
            </div>
          </div>

          <!-- Responsive Trek Grid -->
          <TrekGrid treks={treks} columns={3} resetUrl="/treks" />

          <!-- Responsive Pagination Controls -->
          {totalPages > 1 && (
            <div class="mt-12 flex justify-center">
              <nav class="flex flex-wrap items-center justify-center gap-2" aria-label="Catalog Pagination">
                <!-- Previous Button -->
                {currentPage > 1 ? (
                  <a
                    href={buildPageUrl(currentPage - 1)}
                    class="px-4 py-2.5 rounded-xl border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 active:bg-neutral-100 text-xs sm:text-sm font-semibold transition-colors shadow-xs flex items-center gap-1.5 min-h-[44px]"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </a>
                ) : (
                  <span class="px-4 py-2.5 rounded-xl border border-neutral-200 bg-neutral-100 text-neutral-400 text-xs sm:text-sm font-semibold cursor-not-allowed flex items-center gap-1.5 min-h-[44px]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </span>
                )}

                <!-- Page Numbers -->
                {pageNumbers.map((page) =>
                  page === '...' ? (
                    <span class="px-3 py-2 text-neutral-400 font-bold text-sm">...</span>
                  ) : page === currentPage ? (
                    <span class="w-10 h-10 rounded-xl bg-primary-500 text-white font-bold text-sm flex items-center justify-center shadow-md">
                      {page}
                    </span>
                  ) : (
                    <a
                      href={buildPageUrl(page as number)}
                      class="w-10 h-10 rounded-xl border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 active:bg-neutral-100 font-semibold text-sm flex items-center justify-center transition-colors shadow-xs"
                    >
                      {page}
                    </a>
                  )
                )}

                <!-- Next Button -->
                {currentPage < totalPages ? (
                  <a
                    href={buildPageUrl(currentPage + 1)}
                    class="px-4 py-2.5 rounded-xl border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 active:bg-neutral-100 text-xs sm:text-sm font-semibold transition-colors shadow-xs flex items-center gap-1.5 min-h-[44px]"
                  >
                    Next
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ) : (
                  <span class="px-4 py-2.5 rounded-xl border border-neutral-200 bg-neutral-100 text-neutral-400 text-xs sm:text-sm font-semibold cursor-not-allowed flex items-center gap-1.5 min-h-[44px]">
                    Next
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                )}
              </nav>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Trek With Us Section -->
  <WhyChooseUs />

  <!-- Google Reviews Section -->
  <GoogleReviews client:visible />

  <!-- FAQ Section -->
  <section class="section bg-neutral-50 border-t border-neutral-100">
    <div class="container-custom max-w-3xl">
      <div class="text-center mb-10">
        <span class="inline-block text-primary-500 font-semibold text-xs sm:text-sm uppercase tracking-wider mb-2">Help & Advice</span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-secondary-600">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-4">
        <details class="bg-white rounded-2xl border border-neutral-200/90 overflow-hidden group shadow-xs">
          <summary class="px-6 py-4 font-semibold text-neutral-900 cursor-pointer list-none flex items-center justify-between text-sm sm:text-base">
            How do I book a trek?
            <svg class="w-5 h-5 text-neutral-500 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-4 text-neutral-600 text-xs sm:text-sm leading-relaxed border-t border-neutral-100 pt-3">
            Click on any trek card to view its comprehensive itinerary, available batches, gear checklist, and inclusions. You can submit an enquiry form or message us directly on WhatsApp to reserve your spot.
          </div>
        </details>

        <details class="bg-white rounded-2xl border border-neutral-200/90 overflow-hidden group shadow-xs">
          <summary class="px-6 py-4 font-semibold text-neutral-900 cursor-pointer list-none flex items-center justify-between text-sm sm:text-base">
            What difficulty level should I choose?
            <svg class="w-5 h-5 text-neutral-500 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-4 text-neutral-600 text-xs sm:text-sm leading-relaxed border-t border-neutral-100 pt-3">
            Easy treks suit beginners and families. Moderate treks require basic cardio fitness. Difficult, Challenging, and Extreme expeditions demand prior high-altitude trekking experience and advanced physical preparation.
          </div>
        </details>

        <details class="bg-white rounded-2xl border border-neutral-200/90 overflow-hidden group shadow-xs">
          <summary class="px-6 py-4 font-semibold text-neutral-900 cursor-pointer list-none flex items-center justify-between text-sm sm:text-base">
            When is the best season to trek in the Himalayas?
            <svg class="w-5 h-5 text-neutral-500 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-4 text-neutral-600 text-xs sm:text-sm leading-relaxed border-t border-neutral-100 pt-3">
            Winter (Dec–Feb) is magical for snow trekking (Kedarkantha, Kuari Pass). Summer (April–June) offers lush green meadows and clear skies. Post-monsoon/Autumn (Sept–Nov) delivers crisp visibility and stable weather across Uttarakhand and Himachal.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final Call to Action Banner -->
  <section class="bg-white py-14 sm:py-18 border-t border-neutral-200">
    <div class="container-custom text-center">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-neutral-900 mb-4">
        Ready for Your Next Mountain Adventure?
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-neutral-600 max-w-xl mx-auto mb-8">
        Get your free customized trek itinerary and batch availability details sent directly to your WhatsApp.
      </p>
      <a
        href="/#lead-form"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary-500 hover:bg-primary-600 active:bg-primary-700 text-white font-semibold text-sm sm:text-base rounded-xl shadow-lg hover:shadow-xl transition-all"
      >
        <span>Get Free Itinerary</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Mobile & Tablet Filter Drawer / Sliding Sheet Modal -->
  <div
    id="mobile-filter-drawer"
    class="fixed inset-0 z-50 invisible pointer-events-none transition-all duration-300 opacity-0"
    role="dialog"
    aria-modal="true"
    aria-label="Filter Treks Drawer"
  >
    <!-- Backdrop overlay -->
    <div
      id="mobile-filter-backdrop"
      class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity duration-300 opacity-0"
    ></div>

    <!-- Sliding Drawer Panel -->
    <div
      id="mobile-filter-panel"
      class="fixed inset-y-0 right-0 w-full max-w-xs sm:max-w-sm bg-white shadow-2xl z-10 flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out"
    >
      <!-- Drawer Header -->
      <div class="p-5 border-b border-neutral-100 flex items-center justify-between bg-neutral-50/70">
        <div class="flex items-center gap-2">
          <h3 class="text-base font-bold text-secondary-600">Filter Treks</h3>
          {activeFilters.length > 0 && (
            <span class="w-5 h-5 rounded-full bg-primary-500 text-white text-[11px] font-bold flex items-center justify-center">
              {activeFilters.length}
            </span>
          )}
        </div>
        <button
          id="mobile-filter-close"
          type="button"
          class="p-2 rounded-xl text-neutral-500 hover:text-neutral-800 hover:bg-neutral-200/60 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center"
          aria-label="Close filter drawer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Scrollable Filter Facets -->
      <div class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-6">
        <!-- Difficulty Section -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-3">Difficulty Level</h4>
          <div class="flex flex-wrap gap-2">
            {Object.entries(DIFFICULTY_LABELS).map(([key, val]) => (
              <a
                href={buildFilterUrl({ difficulty: difficulty === key ? undefined : key })}
                class={`px-3 py-2 rounded-xl text-xs font-semibold border transition-all flex items-center gap-1.5 ${
                  difficulty === key
                    ? 'bg-primary-500 text-white border-primary-500 shadow-xs'
                    : 'bg-neutral-50 text-neutral-700 border-neutral-200 hover:border-neutral-300'
                }`}
              >
                <span>{val.label}</span>
                {difficulty === key && (
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>

        <!-- Budget Section -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-3">Budget Range</h4>
          <div class="grid grid-cols-2 gap-2">
            {budgetTiers.filter((t) => t.value).map((tier) => (
              <a
                href={buildFilterUrl({ max_price: maxPrice === tier.value ? undefined : tier.value })}
                class={`p-2.5 rounded-xl text-xs font-semibold border text-center transition-all ${
                  maxPrice === tier.value
                    ? 'bg-primary-500 text-white border-primary-500 shadow-xs'
                    : 'bg-neutral-50 text-neutral-700 border-neutral-200 hover:border-neutral-300'
                }`}
              >
                {tier.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Season Section -->
        {allSeasons.length > 0 && (
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-3">Season / Month</h4>
            <div class="flex flex-wrap gap-2">
              {allSeasons.slice(0, 8).map((s) => (
                <a
                  href={buildFilterUrl({ season: season === s ? undefined : s })}
                  class={`px-3 py-2 rounded-xl text-xs font-semibold border transition-all ${
                    season === s
                      ? 'bg-primary-500 text-white border-primary-500 shadow-xs'
                      : 'bg-neutral-50 text-neutral-700 border-neutral-200 hover:border-neutral-300'
                  }`}
                >
                  {s}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Region Section -->
        {derivedRegions.length > 0 && (
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-3">Region</h4>
            <div class="flex flex-wrap gap-2">
              {derivedRegions.map((r) => (
                <a
                  href={buildFilterUrl({ location: location === r.slug ? undefined : r.slug })}
                  class={`px-3 py-2 rounded-xl text-xs font-semibold border transition-all ${
                    location === r.slug
                      ? 'bg-primary-500 text-white border-primary-500 shadow-xs'
                      : 'bg-neutral-50 text-neutral-700 border-neutral-200 hover:border-neutral-300'
                  }`}
                >
                  {r.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Drawer Footer Actions -->
      <div class="p-4 border-t border-neutral-200 bg-neutral-50 flex items-center gap-3">
        <a
          href="/treks"
          class="flex-1 py-3 px-4 rounded-xl border border-neutral-300 bg-white text-center text-xs sm:text-sm font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors min-h-[44px] flex items-center justify-center"
        >
          Reset All
        </a>
        <button
          id="mobile-filter-apply"
          type="button"
          class="flex-1 py-3 px-4 rounded-xl bg-primary-500 hover:bg-primary-600 text-white text-center text-xs sm:text-sm font-semibold transition-colors shadow-md min-h-[44px] flex items-center justify-center"
        >
          View ({totalItems})
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Filter Drawer JavaScript Controller -->
  <script>
    function setupFilterDrawer() {
      const openBtn = document.getElementById('mobile-filter-open');
      const closeBtn = document.getElementById('mobile-filter-close');
      const applyBtn = document.getElementById('mobile-filter-apply');
      const backdrop = document.getElementById('mobile-filter-backdrop');
      const drawer = document.getElementById('mobile-filter-drawer');
      const panel = document.getElementById('mobile-filter-panel');

      if (!openBtn || !drawer || !panel || !backdrop) return;

      const d = drawer;
      const p = panel;
      const b = backdrop;

      function openDrawer() {
        d.classList.remove('invisible', 'pointer-events-none');
        d.classList.add('opacity-100');
        b.classList.remove('opacity-0');
        b.classList.add('opacity-100');
        p.classList.remove('translate-x-full');
        p.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        p.classList.remove('translate-x-0');
        p.classList.add('translate-x-full');
        b.classList.remove('opacity-100');
        b.classList.add('opacity-0');
        d.classList.remove('opacity-100');
        d.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
          d.classList.add('invisible');
          document.body.style.overflow = '';
        }, 300);
      }

      openBtn.addEventListener('click', openDrawer);
      closeBtn?.addEventListener('click', closeDrawer);
      b.addEventListener('click', closeDrawer);
      applyBtn?.addEventListener('click', closeDrawer);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });
    }

    setupFilterDrawer();
    document.addEventListener('astro:page-load', setupFilterDrawer);
  </script>
</MainLayout>
